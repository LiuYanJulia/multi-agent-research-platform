# Backend Configuration (Local Development Only)
# This file is for running the backend WITHOUT Docker
# For Docker deployment, use the root .env file instead

# Server Configuration
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Configuration (Local MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=research_platform

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Web Search Configuration
ENABLE_WEB_SEARCH=false
WEB_SEARCH_CONTEXT_SIZE=medium

# OpenAI Realtime API Configuration
OPENAI_REALTIME_MODEL=gpt-live-transcribe
OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime

# Security (optional)
JWT_SECRET=your_jwt_secret_for_sessions

# Paper 2: Move-Type Evaluation Agent's fine-tuned model (Phase 4)
EVAL_MODEL_ID=your_finetuned_move_evaluation_model_id_here
# Paper 2: Controller guidance wording experiment. Leave as `template` for the
# deterministic policy text; set to `llm` to rewrite an already-triggered
# policy instruction using the recent content-move context. LLM failure falls
# back automatically to the deterministic template.
GUIDANCE_GENERATION_MODE=template
# Optional; defaults to OPENAI_MODEL, then gpt-4o-mini when LLM mode is enabled.
GUIDANCE_MODEL_ID=gpt-4o-mini
# Keep the experimental content-based D/C classifier off by default. When false,
# the Controller uses the Evaluation Agent's move-type-to-D/C mapping.
ENABLE_DECISION_AGENT=false

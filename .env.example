# Database Configuration
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_USER=research_user
MYSQL_PASSWORD=your_secure_password_here

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Evaluation Agent and direct AI-guidance generation
EVAL_MODEL_ID=your_finetuned_move_evaluation_model_id_here
GUIDANCE_GENERATION_MODE=llm
GUIDANCE_MODEL_ID=gpt-5.6-terra

# Public HTTPS origin of the deployed site. Set this to your actual domain.
FRONTEND_URL=https://your-domain.example

# Use ./nginx-http.conf for an IP-based HTTP smoke test. Switch to
# ./nginx-ssl.conf only after a domain and its TLS certificate are ready.
NGINX_CONFIG=./nginx-http.conf

# Paper 2: optional independent D/C classifier (disabled for the current test path)
ENABLE_DECISION_AGENT=false

# OpenAI Realtime API (for audio transcription)
# Optional - uncomment and modify to change the transcription model:
OPENAI_REALTIME_MODEL=gpt-live-transcribe
OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime
